;
; Development-only INF for Logitech WingMan Force J-UA9.
;

[Version]
Signature="$WINDOWS NT$"
Class=USBDevice
ClassGuid={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%ManufacturerName%
DriverVer=09/11/2026,1.0.0.10
CatalogFile=JUa9TestDriver.cat
PnpLockdown=1

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
JUa9TestDriver.sys=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceDesc%=Device_Install, USB\VID_046D&PID_C281

[DestinationDirs]
DefaultDestDir=12

[Device_Install.NT]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
JUa9TestDriver.sys

[Device_Install.NT.Services]
AddService=JUa9TestDriver,0x00000002,Service_Install

[Service_Install]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\JUa9TestDriver.sys

[Strings]
ManufacturerName="WingMan J-UA9 test driver"
DeviceDesc="Logitech WingMan Force J-UA9 (test driver)"
ServiceDesc="WingMan J-UA9 diagnostic USB driver"
DiskName="WingMan J-UA9 test driver disk"
